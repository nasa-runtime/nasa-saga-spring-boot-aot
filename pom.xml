<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.nasa-runtime</groupId>
    <artifactId>nasa-saga-spring-boot-aot</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>nasa-saga-spring-boot-aot</name>
    <description>Spring Boot AOT and GraalVM native-image hints for nasa-saga participants and persistence resources</description>
    <url>https://github.com/nasa-runtime/nasa-saga-spring-boot-aot</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Nasa Runtime Contributors</name>
            <url>https://github.com/nasa-runtime</url>
            <organization>Nasa Runtime</organization>
            <organizationUrl>https://github.com/nasa-runtime</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/nasa-runtime/nasa-saga-spring-boot-aot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/nasa-runtime/nasa-saga-spring-boot-aot.git</developerConnection>
        <tag>v${project.version}</tag>
        <url>https://github.com/nasa-runtime/nasa-saga-spring-boot-aot/tree/v${project.version}</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/nasa-runtime/nasa-saga-spring-boot-aot/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-10-04T00:00:00Z</project.build.outputTimestamp>
        <nasa-saga.version>1.0.0</nasa-saga.version>
        <nasa-core-aot.version>1.0.4</nasa-core-aot.version>
        <graalvm-nativeimage.version>25.0.0</graalvm-nativeimage.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.nasa-runtime</groupId>
            <artifactId>nasa-saga</artifactId>
            <version>${nasa-saga.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.nasa-runtime</groupId>
            <artifactId>nasa-core-spring-boot-aot</artifactId>
            <version>${nasa-core-aot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>${graalvm-nativeimage.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource><directory>${project.basedir}/src/main/resources</directory></resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>LICENSE</include>
                    <include>LICENSE-APACHE</include>
                    <include>LICENSE-MIT</include>
                    <include>README*.md</include>
                    <include>CONTRIBUTING*.md</include>
                    <include>SECURITY*.md</include>
                    <include>RELEASE*.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>require-build-baseline</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion><version>[3.6.3,)</version></requireMavenVersion>
                                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration><parameters>true</parameters><showWarnings>true</showWarnings><proc>none</proc></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest><addDefaultImplementationEntries>true</addDefaultImplementationEntries><addDefaultSpecificationEntries>true</addDefaultSpecificationEntries></manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.nasaruntime.saga.aot</Automatic-Module-Name>
                            <Implementation-Vendor>Nasa Runtime</Implementation-Vendor>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions><execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration><encoding>UTF-8</encoding><docencoding>UTF-8</docencoding><charset>UTF-8</charset><doclint>all,-missing</doclint></configuration>
                <executions><execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution></executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
                        <executions><execution><id>require-central-release-coordinates</id><goals><goal>enforce</goal></goals><configuration><rules><requireReleaseVersion/><requireReleaseDeps/></rules></configuration></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version>
                        <configuration><bestPractices>true</bestPractices></configuration>
                        <executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.11.0</version><extensions>true</extensions>
                        <configuration><publishingServerId>central</publishingServerId><autoPublish>false</autoPublish><checksums>all</checksums><waitUntil>validated</waitUntil></configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
